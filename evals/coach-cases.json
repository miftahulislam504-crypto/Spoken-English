    { "id": "level-2", "category": "level_fit", "mode": "guided", "scenario": "intro", "level": "Pre-A1", "utterance": "I am from Sirajganj.", "expect": { "understood": true, "reply_max_words": 30, "reply_max_sentence_words": 12 } }
