    { "id": "err-5", "category": "single_error", "mode": "guided", "scenario": "food", "level": "A1", "utterance": "I tea like.", "expect": { "understood": true, "feedback": "required", "error_types": ["word_order"], "corrected_contains": ["like tea"], "max_edit_ratio": 0.7 } },
    { "id": "multi-1", "category": "many_errors", "mode": "free", "level": "A1", "utterance": "Yesterday me and my friend go market and buy two kilo rice.", "expect": { "understood": true, "feedback": "required", "max_edit_ratio": 0.8 } },
