    { "id": "err-2", "category": "single_error", "mode": "guided", "scenario": "family", "level": "A1", "utterance": "She like music.", "expect": { "understood": true, "feedback": "required", "error_types": ["subject_verb_agreement"], "corrected_contains": ["likes"], "max_edit_ratio": 0.5 } },
